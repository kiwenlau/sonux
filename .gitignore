# macOS
.DS_Store

# Xcode 构建产物
build/
DerivedData/

# swiftc 单次编译在仓库根目录生成的临时可执行文件
/main

# 界面验证时临时截图/脚本的输出目录
.tmp-shots/

# 广告检测原型脚本与 Whisper 模型（本地缓存，不入库）
.tmp-adcheck/
tools/models/
tools/adcheck-cache/
tools/.mlx-shard-*.json
tools/.fix-shard-*.json

# MLX 转写环境（GPU 大模型后端，体积大，可由 tools/transcribe.py 头部说明重建）
tools/.venv-mlx/

# 广告切除流水线的运行产物（都能由脚本重算，不入库）
tools/adcheck.jsonl
tools/adcheck.jsonl.recovered
tools/adcuts.jsonl
tools/adcheck-ads.jsonl
tools/adcheck-audit.csv
tools/adcut-report.csv
tools/adcheck-removed.md

# 字幕转写的逐章中间结果与字幕包（由 tools/transcribe.py 重算，体积大不入库）
tools/transcripts-parts/
tools/transcripts-fix/
transcripts/

# 测试用音频书库（体积大，不入库；元数据清单在 tools/books.json）
TestBooks/*
!TestBooks/.gitkeep
TestBooks-clean/
TestBooks-original/

# Xcode 用户个人状态（窗口布局、方案管理等）
xcuserdata/
*.xcuserstate
